source "https://rubygems.org"

gem "hanami", "~> 2.3"
gem "hanami-router", "~> 2.3"
gem "hanami-controller", "~> 2.3"
gem "hanami-validations", "~> 2.3"

# Build tools
gem "rake"

# Database
gem "sqlite3", "~> 2.5"
gem "rom", "~> 5.3"
gem "rom-sql", "~> 3.6"

# Web server
gem "puma"
gem "webrick"

# AI Integration
gem "ruby-openai", "~> 7.0"

# HTTP client for weather API
