<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>
  <div class="container">
    <header class="hero">
      <h1>MateoPlanner</h1>
      <p class="tagline">Your AI-powered European travel companion, enhanced by expert local knowledge</p>
    </header>

    <main>
      <section class="intro">
        <h2>How it works</h2>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <h3>Share Your Preferences</h3>
            <p>Tell us about your dream European trip - destination, dates, budget, and interests.</p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <h3>AI Creates Your Itinerary</h3>
            <p>Our AI analyzes your preferences and crafts a personalized day-by-day itinerary in seconds.</p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <h3>Expert Enhancement</h3>
            <p>A travel expert reviews and enhances your itinerary with insider tips and hidden gems.</p>
          </div>
          <div class="step">
            <div class="step-number">4</div>
            <h3>Start Your Adventure</h3>
            <p>Receive your personalized itinerary with expert recommendations and local insights.</p>
          </div>
        </div>
      </section>

      <section class="cta">
        <a href="/questionnaire" class="btn btn-primary">Start Planning Your Trip</a>
      </section>
    </main>

    <footer>
      <p>&copy; 2025 MateoPlanner. Powered by AI and expert knowledge.</p>
    </footer>
  </div>
</body>
</html>
